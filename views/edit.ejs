<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Workout</title>
  <link rel="stylesheet" href="/main.css">
</head>
<body>

  <%- include("partials/header") %>

  <div class="center-content">
    <h2>Edit Workout</h2>

    <form action="/workouts/<%= workout._id %>/edit" method="POST" class="form">
<div class="form-group">
    <label>Exercise Name</label>
    <input type="text" name="name" value="<%= workout.name %>" required>
      </div>

<div class="form-group">
    <label>Sets</label>
    <input type="number" name="sets" value="<%= workout.sets %>" required>
      </div>

<div class="form-group">
    <label>Reps</label>
    <input type="number" name="reps" value="<%= workout.reps %>" required>
      </div>

<div class="form-group">
    <label>Weight (kg)</label>
    <input type="number" name="weight" value="<%= workout.weight %>">
      </div>

<div class="form-group">
    <label>Date</label>
    <input type="date" name="date" value="<%= workout.date.toISOString().substring(0,10) %>">
      </div>
      
<button type="submit" class="btn-primary">Update Workout</button>

</form>
</div>

  <%- include("partials/footer") %>

</body>
</html>
