<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/main.css">
</head>
<body>

  <%- include("partials/header") %>

  <div class="center-content">
    <h2>Edit Workout</h2>

    <form action="/workouts/<%= workout._id %>/edit" method="POST" class="form">
    <div class="form-group">
    <label for="name">Exercise Name</label>
    <input type="text" id="name" name="name" value="<%= workout.name %>" required>
    </div>

    <div class="form-group">
    <label for="sets">Sets</label>
    <input type="number" id="sets" name="sets" min="1" value="<%= workout.sets %>" required>
    </div>

    <div class="form-group">
    <label for="reps">Reps</label>
    <input type="number" id="reps" name="reps" min="1" value="<%= workout.reps %>" required>
    </div>

    <div class="form-group">
    <label for="weight">Weight (kg)</label>
    <input type="number" id="weight" name="weight" min="0" step="0.5" value="<%= workout.weight || '' %>">
    </div>

    <div class="form-group">
        <label for="date">Date</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= workout.date ? workout.date.toISOString().substring(0,10) : '' %>"
        >
      </div>

      <button type="submit" class="btn-primary">Update Workout</button>
    </form>
  </div>

  <%- include("partials/footer") %>

</body>
</html>
